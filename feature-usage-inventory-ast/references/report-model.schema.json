{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory-report-model/2.0.0",
  "title": "Canonical Inventory Report Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelType", "schemaVersion", "inventoryId", "stage", "status", "target", "scope", "provenance", "executiveSummary", "decisionStatus", "coverage", "capabilities", "stageExecution", "renderProfile", "openChecks", "transition", "ownership", "dictionary", "scenarios", "recipientFamilies", "criticalPaths", "referencePaths", "gaps", "implementationEntryPoints", "confirmedUsages", "checkedNoUsage", "referenceOnly", "noise", "limitations", "evidenceIndex", "integrity"],
  "properties": {
    "modelType": { "const": "inventory-report-model" }, "schemaVersion": { "const": "2.0.0" }, "inventoryId": { "type": "string", "minLength": 1 }, "stage": { "const": 7 }, "status": { "const": "closed" }, "target": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" }, "provenance": { "type": "object" }, "executiveSummary": { "type": "object" }, "decisionStatus": { "enum": ["confirmed", "partial", "unknown", "not-applicable"] }, "coverage": { "type": "object" }, "capabilities": { "type": "array", "minItems": 1, "contains": { "type": "object", "required": ["requiredForFinalReport"], "properties": { "requiredForFinalReport": { "const": true } } }, "items": { "$ref": "#/$defs/capability" } }, "stageExecution": { "type": "object" }, "renderProfile": { "type": "object" }, "openChecks": { "type": "array", "items": { "type": "string" } }, "transition": { "type": "object", "required": ["next stage"], "properties": { "next stage": { "const": "8" } } },
    "ownership": { "$ref": "#/$defs/rows" }, "dictionary": { "$ref": "#/$defs/rows" }, "scenarios": { "$ref": "#/$defs/rows" }, "recipientFamilies": { "$ref": "#/$defs/rows" }, "criticalPaths": { "$ref": "#/$defs/rows" }, "referencePaths": { "$ref": "#/$defs/rows" }, "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } }, "implementationEntryPoints": { "type": "array", "items": { "$ref": "#/$defs/implementationEntry" } }, "confirmedUsages": { "$ref": "#/$defs/rows" }, "checkedNoUsage": { "type": "array", "items": { "$ref": "#/$defs/absence" } }, "referenceOnly": { "$ref": "#/$defs/rows" }, "noise": { "$ref": "#/$defs/rows" }, "limitations": { "$ref": "#/$defs/rows" }, "evidenceIndex": { "$ref": "#/$defs/rows" },
    "integrity": { "type": "object", "additionalProperties": false, "required": ["algorithm", "canonicalDigest"], "properties": { "algorithm": { "const": "sha256" }, "canonicalDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  },
  "$defs": {
    "refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nonEmptyRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "repository": { "type": "object", "required": ["id", "root", "role"], "properties": { "id": { "type": "string", "minLength": 1 }, "root": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 } } },
    "scope": { "type": "object", "required": ["repositories"], "properties": { "repositories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repository" } } } },
    "row": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "type": "string" }, "evidenceRefs": { "$ref": "#/$defs/refs" }, "scenarioRefs": { "$ref": "#/$defs/refs" }, "recipientRefs": { "$ref": "#/$defs/refs" }, "pathRefs": { "$ref": "#/$defs/refs" }, "gapRefs": { "$ref": "#/$defs/refs" }, "capabilityRefs": { "$ref": "#/$defs/refs" }, "testSurfaceRefs": { "$ref": "#/$defs/refs" } }, "allOf": [{ "if": { "properties": { "status": { "const": "checked-no-usage" } }, "required": ["status"] }, "then": { "$ref": "#/$defs/absenceFields" } }] },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "gap": { "allOf": [{ "$ref": "#/$defs/row" }, { "anyOf": [{ "required": ["expectedPath"] }, { "required": ["expectedName"] }, { "required": ["expectedPlace"] }, { "required": ["searchScope"] }, { "required": ["scope"] }] }] },
    "implementationEntry": { "allOf": [{ "$ref": "#/$defs/row" }, { "required": ["evidenceRefs"], "properties": { "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefs" } }, "anyOf": [{ "required": ["scenarioRefs"] }, { "required": ["gapRefs"] }, { "required": ["capabilityRefs"] }, { "required": ["pathRefs"] }] }] },
    "absenceFields": { "required": ["status", "expectedNames", "reason", "repository", "searchScope", "performedChecks", "ordersChecked", "linkingMethodsChecked", "resultComplete", "resultTruncated", "consequence", "evidenceRefs"], "properties": { "status": { "const": "checked-no-usage" }, "expectedNames": { "$ref": "#/$defs/nonEmptyRefs" }, "reason": { "type": "string", "minLength": 1 }, "repository": { "type": "string", "minLength": 1 }, "searchScope": { "type": "string", "minLength": 1 }, "performedChecks": { "$ref": "#/$defs/nonEmptyRefs" }, "ordersChecked": { "$ref": "#/$defs/nonEmptyRefs" }, "linkingMethodsChecked": { "$ref": "#/$defs/nonEmptyRefs" }, "resultComplete": { "const": true }, "resultTruncated": { "const": false }, "consequence": { "type": "string", "minLength": 1 }, "evidenceRefs": { "$ref": "#/$defs/nonEmptyRefs" } } },
    "capability": { "allOf": [{ "$ref": "#/$defs/row" }, { "if": { "properties": { "status": { "const": "checked-no-usage" } }, "required": ["status"] }, "then": { "$ref": "#/$defs/absenceFields" } }] },
    "absence": { "allOf": [{ "$ref": "#/$defs/row" }, { "$ref": "#/$defs/absenceFields" }] }
  }
}
