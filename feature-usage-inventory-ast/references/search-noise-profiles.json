{
  "version": 1,
  "profiles": {
    "r7_default": {
      "description": "Default R7 noise profile for inventory candidate discovery. Use first before widening search scope.",
      "path_globs": [
        "**/.git/**",
        "**/node_modules/**",
        "**/vendor/**",
        "**/resources/help/**",
        "**/search/indexes.js"
      ],
      "file_globs": [
        "**/*.min.js",
        "**/*.map"
      ],
      "directory_names": [
        ".git",
        "node_modules",
        "vendor"
      ]
    },
    "r7_extended": {
      "description": "Extended R7 noise profile for cases where default filtering still returns generated, build, locale, or binary/resource noise.",
      "extends": "r7_default",
      "path_globs": [
        "**/bower_components/**",
        "**/dist/**",
        "**/build/**",
        "**/out/**",
        "**/coverage/**",
        "**/locale/**",
        "**/locales/**",
        "**/translations/**"
      ],
      "file_globs": [
        "**/*.png",
        "**/*.jpg",
        "**/*.jpeg",
        "**/*.gif",
        "**/*.svg",
        "**/*.ico",
        "**/*.woff",
        "**/*.woff2",
        "**/*.ttf",
        "**/*.eot"
      ],
      "directory_names": [
        "bower_components",
        "dist",
        "build",
        "out",
        "coverage",
        "locale",
        "locales",
        "translations"
      ]
    }
  }
}
