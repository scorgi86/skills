{
  "name": "task-research-runtime",
  "version": "4.1.0",
  "private": true,
  "description": "Local runtime for the task-research skill",
  "type": "commonjs",
  "scripts": {
    "check": "node --check scripts/shared/ast/src/prototype_ast.js",
    "diagnose": "node scripts/index.js diagnose --pretty",
    "canonicalize-stage": "node scripts/index.js canonical_stage_cli",
    "validate": "node scripts/index.js quick_validate . && node scripts/index.js validate_skill .",
    "test": "node --test --test-isolation=process --test-concurrency=1",
    "benchmark:stage0": "node scripts/benchmarks/stage0_parallel.js",
    "benchmark:stages": "node scripts/benchmarks/stages1_7_profile.js"
  },
  "dependencies": {
    "@swc/core": "1.15.43"
  }
}
